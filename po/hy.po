#: src/MainWindow.vala:15
msgid "Feedback"
msgstr "Հետադարձ կապ"

#: src/MainWindow.vala:25
msgid "Send feedback for which component?"
msgstr "Ո՞ր բաղադրիչի համար թողնել կարծիք։"

#: src/MainWindow.vala:34
msgid ""
"Select an item from the list to send feedback or report a problem from your "
"web browser."
msgstr ""
"Ընտրեք ցանկից տարր՝ Ձեր դիտարկչից կարծիք թողնելու կամ խնդիր հաղորդելու համար։"

#: src/MainWindow.vala:43
msgid "Search"
msgstr "Որոնել"

#: src/MainWindow.vala:59 src/MainWindow.vala:61
msgid "Categories"
msgstr "Կատեգորիաներ"

#: src/MainWindow.vala:85
msgid ""
"Change search terms to the name of an installed app, panel indicator, system "
"settings page, or desktop component."
msgstr ""
"Փոխեք որոնման բառը տեղադրված հավելվածի, վահանակի ցուցիչի, համակարգի "
"կարգավորումների էջի կամ աշխատասեղանի բաղադրիչի անվանմամբ։"

#: src/MainWindow.vala:165
msgid "Components"
msgstr "Բաղադրիչներ"

#: src/MainWindow.vala:177
msgid "Cancel"
msgstr "Չեղարկել"

#: src/MainWindow.vala:181
msgid "Send Feedback…"
msgstr "Թողնել կարծիք…"

#: src/MainWindow.vala:263
#, c-format
msgid "No results found for “%s”"
msgstr "«%s»-ի համար արդյունքներ չեն գտնվել"

#: src/MainWindow.vala:264
msgid "Search Results"
msgstr "Որոնման արդյունքներ"

#: src/MainWindow.vala:416
msgid "Panel Indicators"
msgstr "Վահանակի ցուցիչներ"

#: src/MainWindow.vala:418
msgid "System Settings"
msgstr "Համակարգի կարգավորումներ"

#: src/MainWindow.vala:420
msgid "Desktop Components"
msgstr "Աշխատասեղանի բաղադրիչներ"

#: src/MainWindow.vala:422
msgid "Default Apps"
msgstr "Լռելյայն հավելվածներ"
