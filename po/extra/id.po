#: data/feedback.metainfo.xml.in:10 data/feedback.desktop.in:6
msgid "Feedback"
msgstr "Umpan Balik"

#: data/feedback.metainfo.xml.in:11
msgid "File issue reports"
msgstr "Ajukan laporan masalah"

#: data/feedback.metainfo.xml.in:13
msgid ""
"Browse installed components by category and quickly find their online issue "
"trackers."
msgstr ""
"Telusuri komponen terpasang berdasarkan kategori dan temukan pelacak masalah "
"daringnya dengan cepat."

#: data/feedback.metainfo.xml.in:18
msgid "Filter components by category"
msgstr "Saring komponen berdasarkan kategori"

#: data/feedback.metainfo.xml.in:22
msgid "Select from a list with icons"
msgstr "Pilih dari daftar dengan ikon"

#: data/feedback.metainfo.xml.in:55
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/feedback.metainfo.xml.in:63 data/feedback.metainfo.xml.in:76
#: data/feedback.metainfo.xml.in:86 data/feedback.metainfo.xml.in:95
#: data/feedback.metainfo.xml.in:108 data/feedback.metainfo.xml.in:122
#: data/feedback.metainfo.xml.in:148
msgid "Improvements:"
msgstr "Peningkatan:"

#: data/feedback.metainfo.xml.in:65
msgid "Improved screen reader accessibility"
msgstr "Tingkatkan aksesibilitas pembaca layar"

#: data/feedback.metainfo.xml.in:66 data/feedback.metainfo.xml.in:79
#: data/feedback.metainfo.xml.in:88 data/feedback.metainfo.xml.in:98
#: data/feedback.metainfo.xml.in:111 data/feedback.metainfo.xml.in:127
#: data/feedback.metainfo.xml.in:141 data/feedback.metainfo.xml.in:155
msgid "Updated translations"
msgstr "Terjemahan diperbarui"

#: data/feedback.metainfo.xml.in:78
msgid "Add Maps and Monitor"
msgstr "Tambah Peta dan Monitor"

#: data/feedback.metainfo.xml.in:97
msgid "Fix missing help when a search has no results"
msgstr "Perbaiki bantuan yang hilang saat pencarian tidak ada hasil"

#: data/feedback.metainfo.xml.in:110
msgid "Don't include apps or addons in Desktop category"
msgstr "Jangan sertakan aplikasi atau pengaya di kategori Desktop"

#: data/feedback.metainfo.xml.in:124
msgid "Launch instantly"
msgstr "Jalankan seketika"

#: data/feedback.metainfo.xml.in:125
msgid "Improved keyboard navigation and add double-click launch"
msgstr "Tingkatkan navigasi papan ketik dan tambah peluncuran klik ganda"

#: data/feedback.metainfo.xml.in:126
msgid "Improve responsiveness for small displays"
msgstr "Tingkatkan responsivitas untuk tampilan kecil"

#: data/feedback.metainfo.xml.in:138 data/feedback.metainfo.xml.in:153
msgid "Minor updates:"
msgstr "Pembaruan kecil:"

#: data/feedback.metainfo.xml.in:140
msgid "Make sure we fetch all addons for System Settings and the Panel"
msgstr "Pastikan semua pengaya untuk Pengaturan Sistem dan Panel diambil"

#: data/feedback.metainfo.xml.in:150
msgid "Avoid focus stealing prevention when opening a web browser"
msgstr "Hindari pencegahan pencurian fokus saat membuka peramban web"

#: data/feedback.metainfo.xml.in:151
msgid "Show more entries under Desktop Components"
msgstr "Tampilkan lebih banyak entri di bawah Komponen Desktop"

#: data/feedback.desktop.in:7
msgid "Report a problem"
msgstr "Laporkan masalah"

#: data/feedback.desktop.in:9
msgid "bug;issue;report;"
msgstr "bug;masalah;laporan;issue;report;"
